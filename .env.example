# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WebAuthn (Relying Party)
# rpID must equal the host (no protocol, no port). Use "localhost" in dev.
NEXT_PUBLIC_RP_ID=localhost
NEXT_PUBLIC_RP_NAME=University 2FA
# rpOrigin must include protocol + port; comma-separate multiple allowed origins.
NEXT_PUBLIC_RP_ORIGIN=http://localhost:3000

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
